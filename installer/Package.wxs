<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Per-user install into %LOCALAPPDATA%\Programs\QuickMail: no admin prompt, so in-app updates
    can install silently. Each release is a major upgrade that replaces the previous version.
  -->
  <Package Name="QuickMail"
           Manufacturer="Blackcat Data Solutions Limited"
           Version="$(var.Version)"
           UpgradeCode="E40D1FD5-3904-4022-99C6-F76043C2F929"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of QuickMail is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="QuickMailIcon" SourceFile="..\src\QuickMail\Assets\QuickMail.ico" />
    <Property Id="ARPPRODUCTICON" Value="QuickMailIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jakemorgangit/QuickMail" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="QuickMail" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppPublishDir)**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="54901002-A12B-4413-9E89-8E6188225583">
        <Shortcut Id="QuickMailStartMenu" Name="QuickMail" Description="Fast email for all your accounts"
                  Target="[INSTALLFOLDER]QuickMail.exe" WorkingDirectory="INSTALLFOLDER" Icon="QuickMailIcon" />
        <RegistryValue Root="HKCU" Key="Software\QuickMail" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="7A3C9E21-5B6D-4F0A-9C1E-2D8B4F6A1C3E">
        <Shortcut Id="QuickMailDesktop" Name="QuickMail" Target="[INSTALLFOLDER]QuickMail.exe" WorkingDirectory="INSTALLFOLDER" Icon="QuickMailIcon" />
        <RegistryValue Root="HKCU" Key="Software\QuickMail" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Component Id="InstallFolderCleanup" Directory="INSTALLFOLDER" Guid="B2E5D8F1-3A7C-4E9B-8D2F-6C1A9E4B7D05">
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\QuickMail" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="QuickMail">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallFolderCleanup" />
    </Feature>

    <!-- Start QuickMail once installation (or an in-app update) finishes. -->
    <CustomAction Id="LaunchQuickMail" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]QuickMail.exe&quot;" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchQuickMail" After="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
