<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>Pidge-$(Version)-x64</OutputName>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Platform>x64</Platform>
    <!-- Folder containing `dotnet publish` output for the app. -->
    <AppPublishDir Condition="'$(AppPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\</AppPublishDir>
    <DefineConstants>Version=$(Version);AppPublishDir=$(AppPublishDir)</DefineConstants>
    <!-- Per-user installs keep files under %LOCALAPPDATA%; these ICEs only apply to per-machine layouts. -->
    <SuppressIces>ICE38;ICE60;ICE64;ICE91</SuppressIces>
  </PropertyGroup>
</Project>
