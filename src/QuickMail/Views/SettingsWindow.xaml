<Window x:Class="QuickMail.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="620" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource DarkWindow}">
    <DockPanel Margin="28,20,28,22">
        <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource OutlineButton}" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
            <Button Content="Save" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="90" Click="Save_Click"/>
        </StackPanel>

        <TabControl>
            <!-- General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Check for new mail every" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="IntervalBox" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Text="Messages to download per folder on first sync" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="InitialCountBox" Width="200" HorizontalAlignment="Left"/>

                        <CheckBox x:Name="BlockImagesBox" Margin="0,18,0,0" Content="Block remote images (protects your privacy and stops read-tracking)"/>
                        <CheckBox x:Name="DarkReadingBox" Margin="0,12,0,0" Content="Dark reading mode for emails"/>
                        <CheckBox x:Name="UpdatesBox" Margin="0,12,0,0" Content="Check for updates when QuickMail starts"/>

                        <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" Margin="0,22,0,6"/>
                        <TextBlock Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" LineHeight="21">
                            Ctrl+N new message · Ctrl+D dashboard · Ctrl+0 all inboxes · Ctrl+1…9 jump to account · Ctrl+F search · F5 refresh<LineBreak/>
                            In the list: R reply · A reply all · F forward · E archive · Del delete · J spam · S flag · U read/unread<LineBreak/>
                            Compose: Ctrl+Enter send · Ctrl+K link · Ctrl+Shift+S save draft
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Spam -->
            <TabItem Header="Spam &amp; learning">
                <StackPanel>
                    <TextBlock Text="Spam sensitivity" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Relaxed" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        <Slider x:Name="ThresholdSlider" Grid.Column="1" Minimum="0.45" Maximum="0.9" Margin="12,0" IsDirectionReversed="True"
                                TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Strict" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <CheckBox x:Name="MoveSpamBox" Margin="0,16,0,0" Content="Move detected spam to each account's server Spam folder"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="27,4,0,0"
                               Text="When off, suspected spam stays in the inbox but is hidden under the 'Suspected spam' filter for you to review."/>

                    <Border CornerRadius="10" Background="{StaticResource Bg2}" Padding="16,14" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="What QuickMail has learned" FontWeight="SemiBold"/>
                            <TextBlock x:Name="LearnText" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Every time you press Spam or Not spam, the filter learns the words, senders and domains involved. It starts using what it has learned once it has seen at least 5 of each."/>
                            <Button Content="Reset learning" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ResetLearning_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- Blocked -->
            <TabItem Header="Blocked senders">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Mail from these senders goes straight to the bin in every account. Use @domain.com to block a whole domain."/>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BlockBox" Tag="spammer@example.com or @example.com"/>
                        <Button Grid.Column="1" Content="Block" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="AddBlock_Click"/>
                    </Grid>
                    <ListBox x:Name="BlockedList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Bg2}" CornerRadius="7" Padding="12,6,6,6" Margin="0,0,0,5">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Pattern}"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="8,4" Click="Unblock_Click" Tag="{Binding Pattern}">
                                            <TextBlock Text="Unblock" Foreground="{StaticResource AccentHoverBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Backup -->
            <TabItem Header="Backup &amp; move">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" LineHeight="20"
                               Text="Export every account (including passwords), your blocked and trusted senders, contacts, spam learning and settings into a single file. Import it on another computer to be up and running in seconds."/>
                    <Border CornerRadius="10" Background="{StaticResource Bg2}" Padding="16,14" Margin="0,16,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" Foreground="{StaticResource OkBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Password protected" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="The file is encrypted with AES-256 using a password you choose. Without that password it can't be opened, and QuickMail can't recover a forgotten one."/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource AccentButton}" Click="Export_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDE1;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Export settings…"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="Import_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                                <TextBlock Text="Import settings…"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- About -->
            <TabItem Header="Updates">
                <StackPanel>
                    <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="QuickMail checks GitHub for new releases and can download and install them for you."/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="CheckButton" Content="Check for updates" Style="{StaticResource AccentButton}" Click="CheckUpdates_Click"/>
                        <TextBlock x:Name="UpdateStatus" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Margin="0,22,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12">
                        <Run Text="Your data lives in "/><Run x:Name="DataPathRun"/>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
