<Window x:Class="QuickMail.Views.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add account" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource DarkWindow}">
    <Window.Resources>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,1,12,0"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="860">
    <StackPanel Margin="28,22,28,24">
        <TextBlock x:Name="Heading" Text="Add an email account" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Enter your address. QuickMail works out the server settings and tells you exactly what it needs."
                   Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>

        <TextBlock Text="Email address" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="EmailBox" Tag="you@example.com" LostFocus="EmailBox_LostFocus" KeyDown="EmailBox_KeyDown"/>

        <!-- ===== Microsoft: sign in with Microsoft (no passwords) ===== -->
        <Border x:Name="MicrosoftPanel" CornerRadius="10" Background="{StaticResource Bg2}" Padding="16,14" Margin="0,16,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Sign in with Microsoft" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,4,0,12"
                           Text="Outlook.com, Hotmail and Microsoft 365 don't accept passwords from mail apps any more. Sign in on Microsoft's page instead. QuickMail never sees your password."/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="MicrosoftButton" Style="{StaticResource AccentButton}" Click="MicrosoftSignIn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,10,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <Rectangle Fill="#F25022" Margin="0,0,1,1"/>
                                <Rectangle Grid.Column="1" Fill="#7FBA00" Margin="1,0,0,1"/>
                                <Rectangle Grid.Row="1" Fill="#00A4EF" Margin="0,1,1,0"/>
                                <Rectangle Grid.Row="1" Grid.Column="1" Fill="#FFB900" Margin="1,1,0,0"/>
                            </Grid>
                            <TextBlock Text="Sign in with Microsoft"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="MicrosoftStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource OkBrush}" TextWrapping="Wrap" MaxWidth="250"/>
                </StackPanel>
                <TextBlock x:Name="MicrosoftNotConfigured" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                           Text="Microsoft sign-in needs a one-time app registration. Add its Application (client) ID in Settings → Accounts, then come back here."/>
            </StackPanel>
        </Border>

        <!-- ===== Password / app password ===== -->
        <StackPanel x:Name="PasswordPanel">
            <!-- Guided app-password steps (Gmail, Yahoo, iCloud) -->
            <Border x:Name="GuidePanel" CornerRadius="10" Background="{StaticResource Bg2}" Padding="16,14" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="GuideTitle" Text="Create an app password" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="GuideIntro" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,4,0,14"/>

                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                        <StackPanel>
                            <TextBlock x:Name="Step1Text" TextWrapping="Wrap"/>
                            <Button x:Name="Step1Button" Style="{StaticResource OutlineButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5" Click="Step1_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Step1Label"/>
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                        <StackPanel>
                            <TextBlock x:Name="Step2Text" TextWrapping="Wrap"/>
                            <Button x:Name="Step2Button" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" Click="Step2_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Step2Label"/>
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
                        <StackPanel>
                            <TextBlock x:Name="Step3Text" TextWrapping="Wrap" Text="Copy the password it shows you, then paste it below."/>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,4,0,0" Click="PasteClipboard_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentHoverBrush}"/>
                                    <TextBlock Text="Paste from clipboard" Foreground="{StaticResource AccentHoverBrush}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="PasswordLabel" Text="Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordBox"/>
            <TextBlock x:Name="PasswordHint" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="Leave blank to keep the current password." Visibility="Collapsed"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Card name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="DisplayNameBox" Tag="e.g. Work, Shop, Personal"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Your name (shown to recipients)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="SenderNameBox" Tag="Jane Smith"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Colour" Style="{StaticResource FieldLabel}"/>
        <ItemsControl x:Name="Swatches">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton GroupName="Swatch" Tag="{Binding}" Checked="Swatch_Checked" Margin="0,0,8,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid Width="26" Height="26">
                                    <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                                    <Ellipse Margin="4" Fill="{Binding Converter={StaticResource HexToBrush}}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Ring" Property="Stroke" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Signature" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="SignatureBox" AcceptsReturn="True" Height="60" VerticalContentAlignment="Top" TextWrapping="Wrap" Tag="Optional"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- Server settings -->
        <Border CornerRadius="8" Background="{StaticResource Bg2}" Padding="12,10" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="DetectText" Text="Server settings will be detected automatically." Foreground="{StaticResource SubBrush}"
                               TextWrapping="Wrap" Margin="0,0,90,0" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="AdvancedToggle" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="8,4"
                                  Checked="AdvancedToggle_Changed" Unchecked="AdvancedToggle_Changed">
                        <TextBlock Text="Advanced" Foreground="{StaticResource AccentHoverBrush}"/>
                    </ToggleButton>
                </Grid>

                <DockPanel x:Name="PresetRow" Margin="0,10,0,0">
                    <TextBlock Text="Use servers from" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="PresetBox" SelectionChanged="PresetBox_SelectionChanged"/>
                </DockPanel>

                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,6,0,0">
                    <TextBlock Text="Username (usually your email address)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameBox"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Incoming (IMAP) server" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ImapHostBox" Tag="imap.example.com"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ImapPortBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Security" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ImapSecurityBox"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Outgoing (SMTP) server" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SmtpHostBox" Tag="smtp.example.com"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SmtpPortBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Security" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SmtpSecurityBox"/>
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,14,0,0">
                        <CheckBox x:Name="SaveTemplateBox" Content="Save these servers as a template named" VerticalAlignment="Center"/>
                        <TextBox x:Name="TemplateNameBox" Margin="10,0,0,0" Tag="e.g. DreamHost"/>
                    </DockPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <Grid Margin="0,20,0,0">
            <StackPanel x:Name="BusyPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="70" Height="3" Foreground="{StaticResource AccentBrush}" Background="{StaticResource Bg3}" BorderThickness="0"/>
                <TextBlock x:Name="BusyText" Text="Connecting…" Foreground="{StaticResource SubBrush}" Margin="10,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
                <Button x:Name="SaveButton" Content="Connect" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="110" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
    </ScrollViewer>
</Window>
