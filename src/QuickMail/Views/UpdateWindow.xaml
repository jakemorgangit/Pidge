<Window x:Class="QuickMail.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource DarkWindow}">
    <StackPanel Margin="26,22,26,22">
        <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentSoftBrush}">
                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentHoverBrush}"/>
            </Border>
            <StackPanel Margin="12,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubText" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border CornerRadius="8" Background="{StaticResource Bg2}" Padding="14,10" Margin="0,16,0,0" MaxHeight="220">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{StaticResource SubBrush}"/>
            </ScrollViewer>
        </Border>

        <ProgressBar x:Name="Progress" Height="4" Margin="0,16,0,0" Maximum="1" Visibility="Collapsed"
                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource Bg3}" BorderThickness="0"/>
        <TextBlock x:Name="StatusText" Foreground="{StaticResource SubBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <Grid Margin="0,14,0,0">
            <Button x:Name="SkipButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Skip_Click">
                <TextBlock Text="Skip this version"/>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Content="Later" Style="{StaticResource OutlineButton}" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
                <Button x:Name="InstallButton" Content="Install and restart" Style="{StaticResource AccentButton}" IsDefault="True" Click="Install_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
