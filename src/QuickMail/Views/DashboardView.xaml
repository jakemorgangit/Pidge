<UserControl x:Class="QuickMail.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Bg1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="PanelSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="-8,0,-8,2"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,14,20">
            <TextBlock Text="{Binding Dashboard.Greeting}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding Dashboard.Summary}" Foreground="{StaticResource SubBrush}" Margin="0,4,0,20"/>

            <!-- KPI tiles -->
            <ItemsControl ItemsSource="{Binding Dashboard.Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Panel}" Padding="16,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Bg3}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding Accent}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource SubBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="Bold" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding Hint}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Accounts breakdown -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Accounts" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Unread per inbox. Click one to jump straight in." Style="{StaticResource PanelSub}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="UNREAD" Style="{StaticResource Caption}" Grid.Column="1" HorizontalAlignment="Right"/>
                            <TextBlock Text="TODAY" Style="{StaticResource Caption}" Grid.Column="2" HorizontalAlignment="Right"/>
                            <TextBlock Text="SPAM" Style="{StaticResource Caption}" Grid.Column="3" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Dashboard.AccountRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}"
                                            Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Card}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource Bg3}" Margin="17,6,10,0">
                                                    <Border Height="4" CornerRadius="2" Background="{Binding Brush}" HorizontalAlignment="Left"
                                                            Width="{Binding UnreadBar, Converter={StaticResource FracToWidth}, ConverterParameter=220}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Unread, StringFormat=N0}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Today, StringFormat=N0}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Spam, StringFormat=N0}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No accounts yet. Add one from the left pane." Foreground="{StaticResource MutedBrush}"
                                   Visibility="{Binding Dashboard.AccountRows.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                    </StackPanel>
                </Border>

                <!-- Volume chart -->
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Incoming mail" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Style="{StaticResource PanelSub}">
                            <Run Text="Last 14 days, all accounts · busiest day "/><Run Text="{Binding Dashboard.MaxDay, Mode=OneWay}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Dashboard.Days}" Height="150">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="20"/>
                                        </Grid.RowDefinitions>
                                        <Border x:Name="Bar" Height="{Binding Height}" VerticalAlignment="Bottom" CornerRadius="4,4,1,1" Margin="3,0"
                                                Background="{StaticResource AccentSoftBrush}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <!-- Categories -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="What's arriving" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Automatically sorted by pattern over the last 30 days." Style="{StaticResource PanelSub}"/>
                        <ItemsControl ItemsSource="{Binding Dashboard.Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}" Margin="8,0,0,0" Foreground="{StaticResource SubBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{StaticResource Bg3}" VerticalAlignment="Center">
                                            <Border Height="6" CornerRadius="3" Background="{Binding Brush}" HorizontalAlignment="Left"
                                                    Width="{Binding Fraction, Converter={StaticResource FracToWidth}, ConverterParameter=180}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}">
                                            <Run Text="{Binding Count, Mode=OneWay, StringFormat=N0}" Foreground="{StaticResource TextBrush}"/> <Run Text="{Binding Percent, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Needs attention -->
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="From people you know" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Unread or flagged mail from people you've written to, across every account." Style="{StaticResource PanelSub}"/>
                        <ItemsControl ItemsSource="{Binding Dashboard.NeedsAttention}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}"
                                            Command="{Binding DataContext.OpenFromDashboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="28" Height="28">
                                                <Ellipse Fill="{Binding AvatarBrush}"/>
                                                <TextBlock Text="{Binding Initials}" FontSize="10.5" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Sender}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subject}" Foreground="{StaticResource SubBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                                <Ellipse Width="7" Height="7" Fill="{Binding AccountBrush}" HorizontalAlignment="Right" Margin="0,5,0,0" ToolTip="{Binding AccountName}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Nothing waiting from your contacts." Foreground="{StaticResource MutedBrush}"
                                   Visibility="{Binding Dashboard.NeedsAttention.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top senders -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Top senders" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Who fills your inboxes most (30 days)." Style="{StaticResource PanelSub}"/>
                        <ItemsControl ItemsSource="{Binding Dashboard.TopSenders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" ToolTip="Show all mail from this sender"
                                            Command="{Binding DataContext.ShowSenderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Address}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="28" Height="28">
                                                <Ellipse Fill="{Binding Avatar}"/>
                                                <TextBlock Text="{Binding Initials}" FontSize="10.5" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Address}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Noisy senders -->
                <Border Grid.Column="1" Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Suggested clean-up" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Senders who email you often but whose messages you almost never open." Style="{StaticResource PanelSub}"/>
                        <ItemsControl ItemsSource="{Binding Dashboard.NoisySenders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource OutlineButton}" Padding="10,4" Content="View"
                                                    Command="{Binding DataContext.ShowSenderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Address}"/>
                                            <Button Style="{StaticResource OutlineButton}" Padding="10,4" Margin="6,0,0,0" Content="Block"
                                                    Command="{Binding DataContext.BlockAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Address}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No noisy senders spotted yet. QuickMail learns as mail arrives." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding Dashboard.NoisySenders.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,10,0,0" Command="{Binding ShowSpamReviewCommand}"
                                Visibility="{Binding SpamCount, Converter={StaticResource CountToVis}}">
                            <TextBlock Foreground="{StaticResource DangerBrush}">
                                <Run Text="Review"/> <Run Text="{Binding SpamCount, Mode=OneWay}"/> <Run Text="suspected spam →"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
