<Window x:Class="Pidge.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:v="clr-namespace:Pidge.Views"
        xmlns:vm="clr-namespace:Pidge.ViewModels"
        Title="Pidge" Width="1440" Height="880" MinWidth="1000" MinHeight="600"
        Style="{StaticResource DarkWindow}" WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="N" Command="{Binding ComposeCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="D" Command="{Binding ShowDashboardCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding ShowUnifiedCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="R" Command="{Binding ReplyCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="R" Command="{Binding ReplyAllCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="L" Command="{Binding ForwardCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemComma" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Account card in the left pane -->
        <DataTemplate x:Key="AccountCardTemplate" DataType="{x:Type vm:AccountCardViewModel}">
            <Button Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" Margin="0,0,0,6" Cursor="Hand" FocusVisualStyle="{x:Null}"
                    ToolTip="{Binding Email}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Sync now" Icon="&#xE895;" Command="{Binding PlacementTarget.Tag.SyncAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        <MenuItem Header="{Binding MuteMenuText}" Icon="&#xE7ED;" Command="{Binding PlacementTarget.Tag.ToggleAccountMuteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        <MenuItem Header="Edit account…" Icon="&#xE70F;" Command="{Binding PlacementTarget.Tag.EditAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Move up" Icon="&#xE70E;" Command="{Binding PlacementTarget.Tag.MoveAccountUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        <MenuItem Header="Move down" Icon="&#xE70D;" Command="{Binding PlacementTarget.Tag.MoveAccountDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Remove account" Icon="&#xE74D;" Command="{Binding PlacementTarget.Tag.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Button.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </Button.Tag>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="10" Background="{StaticResource Bg2}" BorderThickness="1" BorderBrush="Transparent" Padding="10,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{Binding ColorBrush}">
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7ED;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"
                                               Visibility="{Binding IsMuted, Converter={StaticResource BoolToVis}}" ToolTip="Notifications muted for this account"/>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}" Margin="0,0,6,0"
                                               Visibility="{Binding Error, Converter={StaticResource StringToVis}}" ToolTip="{Binding Error}"/>
                                    <TextBlock x:Name="Spin" Text="&#xE895;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"
                                               Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVis}}" RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <Border CornerRadius="9" Padding="7,1" MinWidth="22" Background="{Binding ColorBrush}"
                                            Visibility="{Binding Unread, Converter={StaticResource CountToVis}}">
                                        <TextBlock Text="{Binding Unread}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Bg3}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource Bg3}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{Binding ColorBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinStory">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="Spin" Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:1.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinStory"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Message row. Unread: bright bold text, accent dot and bar, lifted background. Read: dimmed. -->
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type vm:MessageItemViewModel}">
            <Border x:Name="Row" Background="Transparent" Padding="12,10,14,10" Margin="6,1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Brand colour wash (Settings → General), drawn behind the row content -->
                    <Border x:Name="TintLayer" Grid.ColumnSpan="2" Margin="-12,-10,-14,-10" CornerRadius="8" Background="{Binding BrandTint}" IsHitTestVisible="False"/>
                    <Border x:Name="UnreadBar" Width="3" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="-9,2,0,2" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    <Grid x:Name="Avatar" Width="36" Height="36" VerticalAlignment="Top" Margin="0,1,0,0" Opacity="0.75">
                        <Ellipse Fill="{Binding AvatarBrush}" Visibility="{Binding HasBrandLogo, Converter={StaticResource InvBoolToVis}}"/>
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasBrandLogo, Converter={StaticResource InvBoolToVis}}"/>
                        <!-- Company logo (organisations only), on a transparent tile -->
                        <Border CornerRadius="10" Background="{Binding BrandLogoBacking}" Visibility="{Binding HasBrandLogo, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding BrandLogo}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SenderText" Text="{Binding Sender}" TextTrimming="CharacterEllipsis" FontWeight="Normal" Foreground="{StaticResource SubBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <TextBlock Text="&#xE8CA;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"
                                           Visibility="{Binding IsAnswered, Converter={StaticResource BoolToVis}}" ToolTip="Replied"/>
                                <TextBlock x:Name="DateText" Text="{Binding DateText}" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                <!-- Shown while the server is deleting/moving this message -->
                                <StackPanel x:Name="PendingPanel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="{Binding PendingText}">
                                    <TextBlock x:Name="PendingSpin" Text="&#xE895;" Style="{StaticResource Icon}" FontSize="11" RenderTransformOrigin="0.5,0.5"
                                               Foreground="{StaticResource SubBrush}">
                                        <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                                    </TextBlock>
                                    <TextBlock x:Name="PendingIcon" Text="{Binding PendingGlyph}" Style="{StaticResource Icon}" FontSize="13" Margin="6,0,0,0"
                                               Foreground="{StaticResource SubBrush}"/>
                                    <TextBlock x:Name="PendingLabel" Text="{Binding PendingText}" FontSize="11" Margin="5,0,0,0" Foreground="{StaticResource SubBrush}"/>
                                </StackPanel>
                                <Ellipse x:Name="UnreadDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="7,0,0,0" VerticalAlignment="Center"
                                         Visibility="Collapsed" ToolTip="Unread"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SubjectText" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" FontWeight="Normal" Foreground="{StaticResource MutedBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <TextBlock Text="&#xE723;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0"
                                           Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="&#xE7C1;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource WarnBrush}" Margin="6,0,0,0"
                                           Visibility="{Binding IsFlagged, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PreviewText" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" Opacity="0.8"/>
                        <WrapPanel Margin="0,5,0,0">
                            <Border CornerRadius="5" Padding="6,1" Background="{StaticResource Bg3}" Margin="0,0,5,2"
                                    Visibility="{Binding DataContext.IsUnified, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding AccountBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AccountName}" FontSize="10.5" Foreground="{StaticResource SubBrush}" Margin="5,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding TagChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="5" Padding="6,1" Margin="0,0,5,2" BorderBrush="{Binding Brush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="{StaticResource TextBrush}" Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border CornerRadius="5" Padding="6,1" Background="{StaticResource Bg3}" Margin="0,0,5,2"
                                    Visibility="{Binding CategoryLabel, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"/>
                            </Border>
                            <Border CornerRadius="5" Padding="6,1" Background="{StaticResource DangerSoftBrush}" Margin="0,0,5,2"
                                    Visibility="{Binding IsSpam, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Suspected spam" FontSize="10.5" Foreground="{StaticResource DangerBrush}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter TargetName="Row" Property="Background" Value="#171B26"/>
                    <Setter TargetName="UnreadBar" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="UnreadDot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Avatar" Property="Opacity" Value="1"/>
                    <Setter TargetName="SenderText" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="SenderText" Property="Foreground" Value="White"/>
                    <Setter TargetName="SubjectText" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="SubjectText" Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter TargetName="DateText" Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter TargetName="DateText" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="PreviewText" Property="Foreground" Value="{StaticResource SubBrush}"/>
                    <Setter TargetName="PreviewText" Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Bg2}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter TargetName="PendingPanel" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TintLayer" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="DateText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="UnreadDot" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Avatar" Property="Opacity" Value="0.4"/>
                    <Setter TargetName="SubjectText" Property="Opacity" Value="0.5"/>
                    <Setter TargetName="PreviewText" Property="Opacity" Value="0.4"/>
                    <Setter TargetName="SenderText" Property="Opacity" Value="0.6"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PendingSpinStory">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="PendingSpin" Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PendingSpinStory"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDeleting}" Value="True">
                    <Setter TargetName="PendingIcon" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="PendingSpin" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="PendingLabel" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                    <Setter TargetName="SubjectText" Property="TextDecorations" Value="Strikethrough"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Bg3}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="400" MinWidth="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Left pane ================= -->
        <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,14,14,10">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,16">
                        <Image Source="/Assets/Pidge.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Pidge" FontSize="17" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource AccentButton}" Command="{Binding ComposeCommand}" ToolTip="New message (Ctrl+N)" Margin="0,0,0,14" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="New message"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavButton}" Command="{Binding ShowDashboardCommand}" ToolTip="Dashboard (Ctrl+D)">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xECA5;" Style="{StaticResource Icon}" Width="20"/>
                                <TextBlock Text="Dashboard" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="UnifiedButton" Style="{StaticResource NavButton}" Command="{Binding ShowUnifiedCommand}" ToolTip="Every account as one inbox (Ctrl+0)">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" Width="20"/>
                                <TextBlock Text="All inboxes" Margin="10,0,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" CornerRadius="9" Padding="7,1" Background="{StaticResource AccentBrush}"
                                    Visibility="{Binding TotalUnread, Converter={StaticResource CountToVis}}">
                                <TextBlock Text="{Binding TotalUnread}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Grid Margin="4,16,0,8">
                        <TextBlock Text="ACCOUNTS" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" HorizontalAlignment="Right"
                                Content="&#xE710;" Command="{Binding AddAccountCommand}" ToolTip="Add an account"/>
                    </Grid>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="4,6,0,6"
                               ToolTip="{Binding Status}"/>
                    <Grid>
                        <Button Style="{StaticResource NavButton}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings (Ctrl+,)" Margin="0,0,42,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Width="20"/>
                                <TextBlock Text="Settings" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BellButton" HorizontalAlignment="Right" Width="38" Height="36" Click="BellButton_Click" ToolTip="{Binding NotificationStatus}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content" Value="&#xEA8F;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotificationsQuiet}" Value="True">
                                            <Setter Property="Content" Value="&#xE7ED;"/>
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding NotificationStatus}" IsEnabled="False"/>
                                    <Separator/>
                                    <MenuItem Header="Pause for 1 hour" Icon="&#xE823;" Command="{Binding PauseNotificationsCommand}" CommandParameter="1h"/>
                                    <MenuItem Header="Pause until tomorrow morning" Icon="&#xE708;" Command="{Binding PauseNotificationsCommand}" CommandParameter="tomorrow"/>
                                    <MenuItem Header="Pause until I turn them back on" Icon="&#xE7ED;" Command="{Binding PauseNotificationsCommand}" CommandParameter="off"/>
                                    <MenuItem Header="Resume notifications" Icon="&#xEA8F;" Command="{Binding PauseNotificationsCommand}" CommandParameter="resume"/>
                                    <Separator/>
                                    <MenuItem Header="Notification settings…" Icon="&#xE713;" Command="{Binding NotificationSettingsCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource AccountCardTemplate}"/>
                        <Button Command="{Binding AddAccountCommand}" Cursor="Hand" Margin="0,2,0,0" Style="{StaticResource GhostButton}"
                                BorderBrush="{StaticResource Bg4}" BorderThickness="1" Padding="10,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12"/>
                                <TextBlock Text="Add account" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Dashboard (covers list + reader) ================= -->
        <v:DashboardView Grid.Column="1" Grid.ColumnSpan="3" Visibility="{Binding IsDashboard, Converter={StaticResource BoolToVis}}"/>

        <!-- ================= Message list ================= -->
        <DockPanel Grid.Column="1" Visibility="{Binding IsDashboard, Converter={StaticResource InvBoolToVis}}">
            <StackPanel DockPanel.Dock="Top" Margin="18,16,14,6">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding ScopeTitle}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FolderTitle}" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource IconButton}" Content="&#xE8FB;" Command="{Binding MarkAllReadCommand}" ToolTip="Mark everything here as read"/>
                        <Button x:Name="RefreshButton" Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Check for new mail (F5)"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Search mail  (Ctrl+F)" Padding="32,8,9,8"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" HorizontalAlignment="Left" Margin="11,0,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"/>
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <RadioButton Style="{StaticResource FolderTab}" GroupName="Folder" Content="Inbox" IsChecked="{Binding Folder, Converter={StaticResource EnumEquals}, ConverterParameter=Inbox}"/>
                    <RadioButton Style="{StaticResource FolderTab}" GroupName="Folder" Content="Sent" IsChecked="{Binding Folder, Converter={StaticResource EnumEquals}, ConverterParameter=Sent}"/>
                    <RadioButton Style="{StaticResource FolderTab}" GroupName="Folder" Content="Drafts" IsChecked="{Binding Folder, Converter={StaticResource EnumEquals}, ConverterParameter=Drafts}"/>
                    <RadioButton Style="{StaticResource FolderTab}" GroupName="Folder" Content="Archive" IsChecked="{Binding Folder, Converter={StaticResource EnumEquals}, ConverterParameter=Archive}"/>
                    <RadioButton Style="{StaticResource FolderTab}" GroupName="Folder" Content="Spam" IsChecked="{Binding Folder, Converter={StaticResource EnumEquals}, ConverterParameter=Junk}"/>
                    <RadioButton Style="{StaticResource FolderTab}" GroupName="Folder" Content="Bin" IsChecked="{Binding Folder, Converter={StaticResource EnumEquals}, ConverterParameter=Trash}"/>
                    <ToggleButton x:Name="FoldersTab" Style="{StaticResource FolderTab}" IsChecked="{Binding IsCustomFolder, Mode=OneWay}" Click="FoldersTab_Click"
                                  ToolTip="Your other folders on the mail server">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Folders"/>
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="5,1,0,0"/>
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="FoldersPopup" PlacementTarget="{Binding ElementName=FoldersTab}" Placement="Bottom" StaysOpen="False"
                           AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Bg4}" BorderThickness="1" CornerRadius="10"
                                Margin="0,6,0,0" Padding="6" MinWidth="280" MaxHeight="460">
                            <ListBox x:Name="FolderList" FocusVisualStyle="{x:Null}" ItemsSource="{Binding FolderChoices}" PreviewMouseLeftButtonUp="FolderList_Click" KeyDown="FolderList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FolderChoice}">
                                        <Border x:Name="B" CornerRadius="6" Padding="8,6" Background="Transparent">
                                            <Grid>
                                                <StackPanel x:Name="HeaderRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding AccountBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="8,0,0,0" FontSize="11.5"/>
                                                </StackPanel>
                                                <TextBlock x:Name="NoteRow" Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontStyle="Italic" Margin="12,0,0,0" Visibility="Collapsed"/>
                                                <Grid x:Name="FolderRow" Margin="{Binding Indent}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{StaticResource SubBrush}" FontSize="13"/>
                                                        <TextBlock x:Name="FolderName" Text="{Binding Name}" Margin="9,0,30,0" Foreground="{StaticResource TextBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Unread}" HorizontalAlignment="Right" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold"
                                                               Visibility="{Binding Unread, Converter={StaticResource CountToVis}}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter TargetName="HeaderRow" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="FolderRow" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                <Setter TargetName="NoteRow" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="FolderRow" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Selectable}" Value="False">
                                                <Setter TargetName="FolderName" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="B" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, ElementName=B}" Value="True"/>
                                                    <Condition Binding="{Binding Selectable}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="B" Property="Background" Value="{StaticResource Bg3}"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="All" Margin="0,0,6,4" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=All}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="Unread" Margin="0,0,6,4" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Unread}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="Flagged" Margin="0,0,6,4" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Flagged}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="Attachments" Margin="0,0,6,4" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Attachments}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Margin="0,0,6,4" IsChecked="{Binding Filter, Converter={StaticResource EnumEquals}, ConverterParameter=Spam}"
                                 Visibility="{Binding ShowSpamChip, Converter={StaticResource BoolToVis}}" ToolTip="Messages Pidge thinks are spam. Review and confirm.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Suspected spam" Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="{Binding SpamCount}" Margin="5,0,0,0" Foreground="{StaticResource DangerBrush}" FontWeight="Bold"/>
                        </StackPanel>
                    </RadioButton>
                </WrapPanel>
            </StackPanel>

            <Grid>
                <ListBox x:Name="MessageList" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}"
                         SelectedItem="{Binding SelectedMessage}" SelectionMode="Extended"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="MessageList_SelectionChanged" Padding="0,4,0,0" IsTextSearchEnabled="False"
                         ScrollViewer.ScrollChanged="MessageList_ScrollChanged">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
                        <KeyBinding Key="E" Command="{Binding ArchiveCommand}"/>
                        <KeyBinding Key="S" Command="{Binding ToggleFlagCommand}"/>
                        <KeyBinding Key="U" Command="{Binding ToggleReadCommand}"/>
                        <KeyBinding Key="J" Command="{Binding MarkSpamCommand}"/>
                        <KeyBinding Key="R" Command="{Binding ReplyCommand}"/>
                        <KeyBinding Key="A" Command="{Binding ReplyAllCommand}"/>
                        <KeyBinding Key="F" Command="{Binding ForwardCommand}"/>
                        <KeyBinding Key="V" Command="{Binding MoveToFolderCommand}"/>
                    </ListBox.InputBindings>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Reply" Icon="&#xE8CA;" InputGestureText="R" Command="{Binding ReplyCommand}"/>
                            <MenuItem Header="Forward" Icon="&#xE89C;" Command="{Binding ForwardCommand}"/>
                            <Separator/>
                            <MenuItem Header="Mark read / unread" Icon="&#xE8C3;" Command="{Binding ToggleReadCommand}"/>
                            <MenuItem Header="Flag / unflag" Icon="&#xE7C1;" Command="{Binding ToggleFlagCommand}"/>
                            <MenuItem Header="Archive" Icon="&#xE7B8;" Command="{Binding ArchiveCommand}"/>
                            <MenuItem Header="Move to folder…" Icon="&#xE8DE;" InputGestureText="V" Command="{Binding MoveToFolderCommand}"/>
                            <MenuItem Header="Tag…" Icon="&#xE8EC;" InputGestureText="T" Click="TagMenu_Click"/>
                            <MenuItem Header="Manage tags…" Icon="&#xE713;" Command="{Binding ManageTagsCommand}"/>
                            <MenuItem Header="Move to inbox" Icon="&#xE715;" Command="{Binding MoveToInboxCommand}"/>
                            <MenuItem Header="Delete" Icon="&#xE74D;" Command="{Binding DeleteCommand}"/>
                            <Separator/>
                            <MenuItem Header="Mark as spam" Icon="&#xE730;" Command="{Binding MarkSpamCommand}"/>
                            <MenuItem Header="Not spam" Icon="&#xE8FB;" Command="{Binding NotSpamCommand}"/>
                            <MenuItem Header="Block sender" Icon="&#xE8F8;" Command="{Binding BlockSenderCommand}"/>
                            <MenuItem Header="Block entire domain" Icon="&#xE8F8;" Command="{Binding BlockDomainCommand}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
               </ListBox>

                <Button x:Name="LoadMoreButton" Style="{StaticResource OutlineButton}" Background="{StaticResource Bg2}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,14" Padding="14,6" Command="{Binding LoadMoreCommand}" Visibility="Collapsed">
                    <TextBlock Text="Load older messages" Foreground="{StaticResource AccentHoverBrush}"/>
                </Button>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding Messages.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                    <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="34" Foreground="{StaticResource Bg4}"/>
                    <TextBlock Text="{Binding EmptyText}" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Column="2" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch"
                      Visibility="{Binding IsDashboard, Converter={StaticResource InvBoolToVis}}"/>

        <!-- ================= Reader ================= -->
        <Grid Grid.Column="3" Visibility="{Binding IsDashboard, Converter={StaticResource InvBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Reader.HasMessage, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="44" Foreground="{StaticResource Bg4}"/>
                <TextBlock Text="Select a message to read it" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                <TextBlock Text="R reply · A reply all · F forward · E archive · V move · T tag · Del delete · J spam · S flag · U read/unread" Foreground="{StaticResource Bg4}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <DockPanel Visibility="{Binding Reader.HasMessage, Converter={StaticResource BoolToVis}}" Margin="20,12,20,16">
                <!-- Toolbar -->
                <WrapPanel DockPanel.Dock="Top" Margin="-6,0,0,10">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ReplyCommand}" ToolTip="Reply (R / Ctrl+R)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8CA;" Style="{StaticResource Icon}"/><TextBlock Text="Reply" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ReplyAllCommand}" ToolTip="Reply all (A / Ctrl+Shift+R)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C2;" Style="{StaticResource Icon}"/><TextBlock Text="Reply all" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ForwardCommand}" ToolTip="Forward (F / Ctrl+L)">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE89C;" Style="{StaticResource Icon}"/><TextBlock Text="Forward" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding EditDraftCommand}" ToolTip="Continue editing this draft"
                            Visibility="{Binding IsDrafts, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}"/><TextBlock Text="Edit draft" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Background="{StaticResource Bg4}" Margin="6,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7B8;" Command="{Binding ArchiveCommand}" ToolTip="Archive (E)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DeleteCommand}" ToolTip="Delete (Del)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE730;" Command="{Binding MarkSpamCommand}" ToolTip="Mark as spam (J)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8DE;" Command="{Binding MoveToFolderCommand}" ToolTip="Move to folder (V)"/>
                    <Button x:Name="TagButton" Style="{StaticResource IconButton}" Content="&#xE8EC;" Click="TagButton_Click" ToolTip="Tag (T)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7C1;" Command="{Binding ToggleFlagCommand}" ToolTip="Flag (S)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8C3;" Command="{Binding ToggleReadCommand}" ToolTip="Mark read / unread (U)"/>
                    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More" Click="MoreButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Block sender" Icon="&#xE8F8;" Command="{Binding BlockSenderCommand}"/>
                                <MenuItem Header="Block entire domain" Icon="&#xE8F8;" Command="{Binding BlockDomainCommand}"/>
                                <MenuItem Header="Unsubscribe" Icon="&#xE711;" Command="{Binding UnsubscribeCommand}" IsEnabled="{Binding Reader.CanUnsubscribe}"/>
                                <MenuItem Header="Not spam" Icon="&#xE8FB;" Command="{Binding NotSpamCommand}"/>
                                <MenuItem Header="Move to inbox" Icon="&#xE715;" Command="{Binding MoveToInboxCommand}"/>
                                <Separator/>
                                <MenuItem Header="Load images" Icon="&#xEB9F;" Command="{Binding LoadImagesCommand}"/>
                                <MenuItem Header="Dark reading mode" Icon="&#xE706;" IsCheckable="True" IsChecked="{Binding DarkReading}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>

                <!-- Header -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Reader.Subject}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40" VerticalAlignment="Top">
                            <Ellipse Fill="{Binding Reader.Item.AvatarBrush}" Visibility="{Binding Reader.Item.HasBrandLogo, Converter={StaticResource InvBoolToVis}}"/>
                            <TextBlock Text="{Binding Reader.Item.Initials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Reader.Item.HasBrandLogo, Converter={StaticResource InvBoolToVis}}"/>
                            <Border CornerRadius="11" Background="{Binding Reader.Item.BrandLogoBacking}" Visibility="{Binding Reader.Item.HasBrandLogo, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <Image Source="{Binding Reader.Item.BrandLogo}" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0">
                            <WrapPanel>
                                <TextBlock Text="{Binding Reader.FromName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Reader.FromAddress, StringFormat='  &lt;{0}&gt;'}" Foreground="{StaticResource MutedBrush}"/>
                                <Border CornerRadius="5" Padding="6,1" Background="{StaticResource Bg3}" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding Reader.IsFromKnownContact, Converter={StaticResource BoolToVis}}" ToolTip="You've emailed this person before">
                                    <TextBlock Text="Contact" FontSize="10.5" Foreground="{StaticResource OkBrush}"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Foreground="{StaticResource SubBrush}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reader.ToLine}">
                                <Run Text="To: " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Reader.ToLine, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource SubBrush}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Reader.CcLine, Converter={StaticResource StringToVis}}" ToolTip="{Binding Reader.CcLine}">
                                <Run Text="Cc: " Foreground="{StaticResource MutedBrush}"/><Run Text="{Binding Reader.CcLine, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Reader.DateLine}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right"/>
                            <Border CornerRadius="5" Padding="7,2" Background="{StaticResource Bg3}" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Reader.Item.AccountBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Reader.Item.AccountName}" FontSize="11" Foreground="{StaticResource SubBrush}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Padding="6,3" Margin="0,4,-6,0" HorizontalAlignment="Right" Command="{Binding UnsubscribeCommand}"
                                    Visibility="{Binding Reader.CanUnsubscribe, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Unsubscribe" FontSize="11.5" Foreground="{StaticResource AccentHoverBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tags on this message -->
                    <ItemsControl ItemsSource="{Binding Reader.MessageTags}" Margin="52,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TagItemViewModel}">
                                <Border CornerRadius="11" Padding="9,2,3,2" Margin="0,0,6,0" BorderBrush="{Binding Brush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Margin="6,0,2,0" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource IconButton}" Width="20" Height="20" FontSize="9" Content="&#xE711;" ToolTip="Remove tag"
                                                Command="{Binding DataContext.ToggleTagCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Banners -->
                    <Border CornerRadius="8" Background="{StaticResource DangerSoftBrush}" Padding="12,9" Margin="0,12,0,0"
                            Visibility="{Binding Reader.SpamReasons, Converter={StaticResource StringToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE730;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="This looks like spam" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="{Binding Reader.SpamReasons}" Foreground="{StaticResource SubBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource OutlineButton}" Content="Not spam" Command="{Binding NotSpamCommand}" Margin="8,0,0,0" Padding="10,5"/>
                                <Button Style="{StaticResource OutlineButton}" Content="Block" Command="{Binding BlockSenderCommand}" Margin="6,0,0,0" Padding="10,5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border CornerRadius="8" Background="{StaticResource WarnSoftBrush}" Padding="12,9" Margin="0,8,0,0"
                            Visibility="{Binding Reader.PhishingWarning, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarnBrush}" Margin="0,0,10,0"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}">
                                <Run Text="Be careful with links." FontWeight="SemiBold"/> <Run Text="{Binding Reader.PhishingWarning, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="{StaticResource Bg2}" Padding="12,7" Margin="0,8,0,0"
                            Visibility="{Binding Reader.RemoteContentBlocked, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xEB9F;" Style="{StaticResource Icon}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                                <TextBlock Text="Remote images are blocked to protect your privacy." Foreground="{StaticResource SubBrush}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Padding="8,4" Command="{Binding LoadImagesCommand}">
                                    <TextBlock Text="Load images" Foreground="{StaticResource AccentHoverBrush}" FontSize="12"/>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Padding="8,4" Command="{Binding AlwaysLoadImagesCommand}">
                                    <TextBlock Text="Always from this sender" Foreground="{StaticResource AccentHoverBrush}" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Attachments -->
                    <ItemsControl ItemsSource="{Binding Reader.Attachments}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Background="{StaticResource Bg2}" Margin="0,0,6,6" Padding="10,7"
                                        Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                        ToolTip="Click to open · right-click to save">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open" Icon="&#xE8A7;" Command="{Binding PlacementTarget.Tag.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Save as…" Icon="&#xE74E;" Command="{Binding PlacementTarget.Tag.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </Button.Tag>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE723;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentHoverBrush}"/>
                                        <TextBlock Text="{Binding FileName}" Margin="8,0,0,0" Foreground="{StaticResource TextBrush}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SizeText}" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Body -->
                <Grid Margin="0,6,0,0">
                    <Border CornerRadius="10" Background="White" ClipToBounds="True">
                        <wv:WebView2 x:Name="ReaderView" DefaultBackgroundColor="White"/>
                    </Border>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Reader.IsLoading, Converter={StaticResource BoolToVis}}">
                        <Grid Width="40" Height="40" HorizontalAlignment="Center">
                            <Ellipse Stroke="#E3E5EC" StrokeThickness="4"/>
                            <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 20,2 A 18,18 0 0 1 38,20" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform x:Name="ReaderSpin"/></Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="ReaderSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>
                        <TextBlock Text="Downloading this email…" Foreground="#4B5263" FontSize="13" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                        <TextBlock Text="New mail is saved on your PC as it arrives, so this is usually instant." Foreground="#8A90A0" FontSize="11.5"
                                   Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Reader.Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="20" VerticalAlignment="Top"
                               Visibility="{Binding Reader.Error, Converter={StaticResource StringToVis}}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
