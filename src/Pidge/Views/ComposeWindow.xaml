<Window x:Class="Pidge.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Pidge.Views"
        Title="{Binding WindowTitle}" Width="860" Height="760" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" Style="{StaticResource DarkWindow}" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="Enter" Command="{Binding SendCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="18,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header fields -->
        <StackPanel DockPanel.Dock="Top" Background="{StaticResource Bg1}">
            <Border Style="{StaticResource Row}" Padding="18,8">
                <DockPanel>
                    <TextBlock Text="From" Style="{StaticResource RowLabel}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,4" Command="{Binding ToggleCcBccCommand}">
                        <TextBlock Text="Cc / Bcc" FontSize="12"/>
                    </Button>
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding FromAccount}" HorizontalAlignment="Left" MinWidth="320">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" Margin="8,0,0,0" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Email}" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <TextBlock Text="To" Style="{StaticResource RowLabel}"/>
                    <TextBox x:Name="ToBox" Style="{StaticResource BareTextBox}" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Tag="Recipients, separated by commas"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="Cc" Style="{StaticResource RowLabel}"/>
                    <TextBox x:Name="CcBox" Style="{StaticResource BareTextBox}" Text="{Binding Cc, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}" Visibility="{Binding ShowCcBcc, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock Text="Bcc" Style="{StaticResource RowLabel}"/>
                    <TextBox x:Name="BccBox" Style="{StaticResource BareTextBox}" Text="{Binding Bcc, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <DockPanel>
                    <TextBlock Text="Subject" Style="{StaticResource RowLabel}"/>
                    <TextBox x:Name="SubjectBox" Style="{StaticResource BareTextBox}" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource OutlineButton}" Content="Save draft" Click="SaveDraft_Click" Margin="0,0,8,0" ToolTip="Ctrl+Shift+S"/>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding SendCommand}" ToolTip="Send (Ctrl+Enter)" MinWidth="110">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE724;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Send"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE723;" ToolTip="Attach files (or drag them onto this window)" Click="Attach_Click"/>
                    <TextBlock Text="Sending…" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="460"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Attachments -->
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding AttachmentPaths}" Margin="14,0,14,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Bg2}" CornerRadius="7" Padding="10,4,4,4" Margin="0,4,6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE723;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource AccentHoverBrush}"/>
                            <TextBlock Text="{Binding Converter={x:Static Member=local:FileNameConverter.Instance}}" Margin="8,0,4,0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE711;" ToolTip="Remove"
                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <wv:WebView2 x:Name="Editor" DefaultBackgroundColor="#13161E"/>
    </DockPanel>
</Window>
